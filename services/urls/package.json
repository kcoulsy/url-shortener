{
  "name": "urls",
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "bundle": "esbuild --bundle --format=esm --outfile=./dist/index.js --platform=node --target=node20 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" ./src/index.ts",
    "build": "pnpm bundle",
    "build:watch": "pnpm bundle --watch=forever",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "pnpm build && run-p build:watch start:watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src drizzle.config.ts --deny-warnings",
    "lint:fix": "oxlint src drizzle.config.ts --fix",
    "start": "node ./dist/index.js",
    "start:watch": "node --watch ./dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "aws-jwt-verify": "^5.1.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.12.23",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.21.4",
    "npm-run-all2": "^6.2.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.8"
  }
}
