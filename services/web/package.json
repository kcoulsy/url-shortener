{
  "name": "web",
  "type": "module",
  "scripts": {
    "build": "esbuild --bundle --format=esm --outfile=./dist/index.js --platform=node --target=node20 ./src/index.ts",
    "build:watch": "esbuild --bundle --format=esm --outfile=./dist/index.js --platform=node --target=node20 --watch=forever ./src/index.ts",
    "dev": "pnpm build && run-p build:watch start:watch",
    "start": "node ./dist/index.js",
    "start:watch": "node --watch ./dist/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.21.4",
    "npm-run-all2": "^6.2.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.12.23",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "zod": "^4.4.3"
  }
}
